[Unit]
Description=Apex High-Performance Reverse Proxy & Edge Router
Documentation=https://github.com/xdearboy/apex
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apex
Group=apex
ExecStartPre=/usr/bin/apex -t -c /etc/apex/apex.conf
ExecStart=/usr/bin/apex -c /etc/apex/apex.conf
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30s
KillMode=mixed
Restart=on-failure
RestartSec=5s

# Security and resource limits
LimitNOFILE=1048576
LimitNPROC=524288
LimitMEMLOCK=infinity
TasksMax=infinity

# System sandboxing
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Logging & Output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apex

[Install]
WantedBy=multi-user.target

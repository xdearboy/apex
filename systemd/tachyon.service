[Unit]
Description=tachyon - Ultra High-Performance kTLS HTTP/HTTPS Engine
Documentation=https://github.com/xdearboy/tachyon
After=network.target network-online.target

[Service]
Type=simple
User=tachyon
Group=tachyon
WorkingDirectory=/opt/tachyon
ExecStart=/usr/local/bin/tachyon -p 443 -b 0.0.0.0 -c /etc/letsencrypt/live/your-domain/fullchain.pem -k /etc/letsencrypt/live/your-domain/privkey.pem
Restart=always
RestartSec=1s

LimitNOFILE=1048576
LimitNPROC=512000
LimitMEMLOCK=infinity

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
KillMode=control-group
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
